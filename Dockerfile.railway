# Railway build for Hermes WebUI — a clean customization layer over the upstream image.
# FROM :latest keeps daily auto-updates; this file only ADDS, so fork syncs never conflict.
FROM ghcr.io/nesquena/hermes-webui:latest

USER root

# Document-reading toolchain (NO MCP / NO vision model needed):
#   poppler-utils -> pdftotext (text PDFs) + pdftoppm (rasterize scanned PDFs)
#   tesseract-ocr -> OCR for scanned PDFs / images / screenshots (English + Malay)
# Pure CLI so it doesn't depend on the runtime venv. Kept ABOVE the cache-bust so it stays cached.
RUN (apt-get update && apt-get install -y --no-install-recommends \
       tesseract-ocr tesseract-ocr-eng tesseract-ocr-msa poppler-utils file ghostscript \
     && rm -rf /var/lib/apt/lists/*) \
 || (apk add --no-cache tesseract-ocr tesseract-ocr-data-eng poppler-utils file) \
 || true

# Node (required by the npx-based MCP servers)
RUN curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz -o /tmp/node.txz \
 && mkdir -p /opt/node && tar -xJf /tmp/node.txz -C /opt/node --strip-components=1 \
 && rm -f /tmp/node.txz
ENV PATH="/opt/node/bin:${PATH}"

# Pre-install MCP server packages so they start instantly (no boot-time npx download race)
# NOTE: 'vercel' here is the Vercel CLI (not an MCP server). vercel-mcp was removed — it exited on launch.
# The developer role deploys with `vercel --token $VERCEL_TOKEN` instead. Fully headless + reliable.
RUN /opt/node/bin/npm install -g @supabase/mcp-server-supabase@latest @modelcontextprotocol/server-github agentql-mcp railway-mcp peninglab-mcp @playwright/mcp@latest vercel || true

# Playwright + Chromium baked into the image (HEAVY — kept ABOVE the cache-bust so it stays cached)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN /opt/node/bin/npx -y playwright@latest install --with-deps chromium \
 || /opt/node/bin/npx -y playwright@latest install chromium || true

# OmniRoute — OpenAI-compatible LLM gateway (177 providers, vision, auto-fallback, token compression).
# Runs internally on 127.0.0.1:20128; Hermes proxies /omni/* to it and the agent can use its /v1.
# Heavy (Next.js app) but kept ABOVE the cache-bust so it stays cached. Fail-safe (|| true).
RUN /opt/node/bin/npm install -g omniroute || true

ENV HERMES_WEBUI_AGENT_DIR=/opt/hermes

# ---- DAILY REFRESH BOUNDARY ----
# The CI bumps buildstamp.txt each day; that invalidates every layer BELOW this line,
# so hermes-agent + skills are re-cloned fresh on each scheduled build (always latest),
# while Node/Chromium above stay cached (fast builds).
COPY buildstamp.txt /opt/buildstamp.txt

# Hermes Agent backend (provides the agent/, hermes_cli, run_agent modules the WebUI imports)
RUN git clone --depth 1 https://github.com/NousResearch/hermes-agent /opt/hermes

# Claude Code skills (superpowers) registered as an external skills dir
RUN git clone --depth 1 https://github.com/obra/superpowers /opt/skills/superpowers

# Extra skills (Meta Ads, etc.) + caveman
COPY railway-skills /opt/skills-extra
# Live AI-agents dashboard, served same-origin from Hermes at /static/pixel.html
COPY pixel.html /apptoo/static/pixel.html
# Real Claude-Office room art + character sprites (MIT, W17ant/Claude-Office), web-light (~0.7MB).
# Served at /static/office/* — the dashboard renders the real isometric office with these.
COPY office /apptoo/static/office
# OmniRoute: dynamic config tab + same-origin reverse proxy (/omni/* -> 127.0.0.1:20128).
COPY omniroute.html /apptoo/static/omniroute.html
COPY omniroute_proxy.py /apptoo/api/omniroute_proxy.py
RUN cp -f /apptoo/api/omniroute_proxy.py /app/api/omniroute_proxy.py 2>/dev/null || true
# Sidebar icon -> OmniRoute tab (same pattern as the AI Agents Floor link)
RUN sed -i 's#<div class="rail-spacer"></div>#<a class="rail-btn has-tooltip" href="/static/omniroute.html" target="_blank" rel="noopener" data-tooltip="OmniRoute" aria-label="OmniRoute"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="2.4"/><circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="12" r="2.4"/><path d="M8.4 6H13a4 4 0 0 1 4 4v.4M8.4 18H13a4 4 0 0 0 4-4v-.4"/></svg></a><div class="rail-spacer"></div>#' /apptoo/static/index.html || true
# Same-origin proxy hook: route /omni/* through OmniRoute (placed AFTER check_auth, so it's login-gated).
RUN for SRV in /apptoo/server.py /app/server.py; do [ -f "$SRV" ] && sed -i \
      -e 's#^\(\s*\)result = handle_get(self, parsed)#\1if parsed.path.startswith("/omni"):\n\1    from api.omniroute_proxy import proxy_omni; return proxy_omni(self, parsed)\n\1result = handle_get(self, parsed)#' \
      -e 's#^\(\s*\)result = route_func(self, parsed)#\1if parsed.path.startswith("/omni"):\n\1    from api.omniroute_proxy import proxy_omni; return proxy_omni(self, parsed)\n\1result = route_func(self, parsed)#' \
      "$SRV"; done || true
# Enable Ctrl+V paste of images into the chat (hooks the existing global addFiles()). drag-drop already works.
COPY paste-image.js /apptoo/static/paste-image.js
RUN sed -i 's#</body>#<script src="static/paste-image.js?v=hermes"></script></body>#' /apptoo/static/index.html || true
# Add a pixel 'AI Agents Floor' tab to the left sidebar (opens /static/pixel.html)
RUN sed -i 's#<div class="rail-spacer"></div>#<a class="rail-btn has-tooltip" href="/static/pixel.html" target="_blank" rel="noopener" data-tooltip="AI Agents Floor" aria-label="AI Agents Floor"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg></a><div class="rail-spacer"></div>#' /apptoo/static/index.html || true
RUN git clone --depth 1 https://github.com/JuliusBrussee/caveman /tmp/caveman && cp -r /tmp/caveman/.agents/skills/cavecrew /opt/skills-extra/cavecrew && rm -rf /tmp/caveman
# Marketing skills (irinabuht12-oss/marketing-skills): flat .md -> SKILL.md dirs under /opt/skills-extra/marketing
# NOTE: converted with node (the runtime venv python does not exist at build time).
COPY scripts/import_marketing_skills.js /opt/import_marketing_skills.js
RUN git clone --depth 1 https://github.com/irinabuht12-oss/marketing-skills /tmp/mkskills \
 && /opt/node/bin/node /opt/import_marketing_skills.js /tmp/mkskills /opt/skills-extra/marketing \
 && rm -rf /tmp/mkskills

# Fold the remaining 'marketer' skill (new-client) INTO 'marketing' (single marketing group).
RUN cp -r /opt/skills-extra/marketer/. /opt/skills-extra/marketing/ && rm -rf /opt/skills-extra/marketer

# SHARED 'general' skills every profile gets (whatsapp-whacenter, etc.). Placed DIRECTLY under
# /opt/skills-common (no sub-folder) so they show in the GENERAL category for every profile.
RUN mkdir -p /opt/skills-common && cp -r /opt/skills-extra/common/. /opt/skills-common/ && rm -rf /opt/skills-extra/common

# Per-role skill bundles (category-preserving). mcp_setup points each profile at its own bundle + the shared common dir:
#   marketer -> /opt/skills-mkt (marketing + meta-ads)   developer -> superpowers + /opt/skills-dev (dev + cavecrew)   ALL -> /opt/skills-common
RUN mkdir -p /opt/skills-mkt /opt/skills-dev \
 && cp -r /opt/skills-extra/marketing /opt/skills-mkt/marketing \
 && cp -r /opt/skills-extra/meta-ads  /opt/skills-mkt/meta-ads \
 && cp -r /opt/skills-extra/dev       /opt/skills-dev/dev \
 && cp -r /opt/skills-extra/cavecrew  /opt/skills-dev/cavecrew

# Boot-time helpers
COPY mcp_setup.py /opt/mcp_setup.py
COPY start_gateways.sh /opt/start_gateways.sh
COPY seed_omniroute.sh /opt/seed_omniroute.sh
COPY init_workspaces.sh /opt/init_workspaces.sh
COPY seed_roles.sh /opt/seed_roles.sh

# Make the "New space" form auto-create the folder (force the backend create flag on)
RUN sed -i 's/auto_create = body.get("create", False)/auto_create = True/' /apptoo/api/routes.py || true
# Relative workspace names resolve under the PERSISTENT VOLUME (/home/hermeswebui/.hermes/workspace),
# NOT ephemeral /app or an ephemeral /workspace. This is the durable location across restarts.
RUN sed -i '/path_str = _strip_surrounding_quotes/a\    if path_str and path_str[0] not in ("/", "~"): path_str = "/home/hermeswebui/.hermes/workspace/" + path_str' /apptoo/api/routes.py || true
# Also make /workspace itself a symlink to the volume (baked as root so it persists), so any
# hardcoded /workspace/<name> path the agent uses also lands on the persistent volume.
RUN rm -rf /workspace && ln -sfn /home/hermeswebui/.hermes/workspace /workspace
# Skills TAB must be PER-PROFILE: read external_dirs from the ACTIVE profile's config,
# not the process-global one (otherwise marketer shows dev/general too). #per-profile-skills
RUN sed -i 's#dirs.extend(Path(p) for p in get_external_skills_dirs())#import yaml as _y; _cp=_active_profile_config_path(); _c=((_y.safe_load(_cp.read_text(encoding="utf-8")) or {}) if _cp.exists() else {}); dirs.extend(Path(p) for p in ((_c.get("skills") or {}).get("external_dirs") or []))#' /apptoo/api/routes.py || true

# Patch the upstream init: (1) line-164 env-reload crash guard,
# (2) auto-create workspaces + write MCP config + launch the gateway daemon before the server.
RUN sed -i '/read -r key value; do/a\      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue' /hermeswebui_init.bash \
 && sed -i '/cd \/app; python server.py/i\sh /opt/init_workspaces.sh || true ; sh /opt/seed_roles.sh || true ; /app/venv/bin/python /opt/mcp_setup.py || true ; sh /opt/start_gateways.sh || true ; echo "== mcp config + gateway launched =="' /hermeswebui_init.bash

USER root
# CMD is inherited from the base image (/hermeswebui_init.bash), now patched.
